# Telegram bot used by the contact form (server-side only — never exposed to the client).
# Create a bot with @BotFather to get the token, and use @userinfobot to find your chat id.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Canonical site URL used in sitemap, canonical links and structured data.
NEXT_PUBLIC_SITE_URL=https://baxtiyorov.dev

# Optional search-engine ownership checks (the content="..." value of each
# service's HTML-tag method). Leave unset to omit the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# --- Admin panel (/admin) ----------------------------------------------------
# Postgres for editable content + visit statistics. On Vercel: Storage → Neon,
# then use the *pooled* connection string. Without it the site shows the static
# content from src/data and analytics is off.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin login password (use a long, unique one).
ADMIN_PASSWORD=change-me
# Random secret, at least 32 characters, for signing the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Image uploads from the admin panel. Added automatically when a Vercel Blob
# store is connected to the project (Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# Optional: separate salt for hashing visitors (defaults to ADMIN_SESSION_SECRET).
ANALYTICS_SALT=
